---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin · Football registration"><main><p class="eyebrow">PRIVATE AREA</p><form class="back-form" action="/" method="get"><button type="submit">← Back to public registration</button></form><h1>Admin</h1><section class="panel"><form id="login"><label>Password <input type="password" name="password" required></label><button>Sign in</button></form><div id="editor" hidden><p>Drag rows to reorder. Rows 1–10 are players; the rest are reserves.</p><button id="create" type="button">Create test fixture</button><button id="finalize" type="button">Finalize current selection</button><label>Historical fixture <select id="fixture-select"></select></label><div id="lineup"></div><button id="save" type="button">Save lineup</button></div><div id="dashboard" hidden><h2>Database dashboard</h2><p class="muted">Read-only snapshot of fixtures, availability, and stored lineups.</p><div id="dashboard-content"></div></div><p id="msg"></p></section></main><script>
// @ts-nocheck
const login=document.querySelector('#login'), editor=document.querySelector('#editor'), msg=document.querySelector('#msg');
document.querySelector('#create').onclick=async()=>{const r=await fetch('/api/admin/test-fixture',{method:'POST'});const d=await r.json();msg.textContent=r.ok?(d.created?'Test fixture created for ':'Test fixture already exists for ')+new Date(d.startsAt).toLocaleString()+' — return to public registration to enter availability.':d.error};
login.onsubmit=async e=>{e.preventDefault();const r=await fetch('/api/admin/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:new FormData(login).get('password')})});if(r.ok){login.hidden=true;editor.hidden=false;document.querySelector('#dashboard').hidden=false;dashboard().then(load)}else msg.textContent='Invalid password.'};
const esc=value=>String(value??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
async function dashboard(){const r=await fetch('/api/admin/dashboard');if(!r.ok)return;const d=await r.json();const finalized=d.fixtures.filter(f=>f.finalized_at);document.querySelector('#fixture-select').innerHTML=finalized.map(f=>'<option value="'+f.id+'">'+esc(f.starts_at)+'</option>').join('');document.querySelector('#fixture-select').onchange=load;document.querySelector('#dashboard-content').innerHTML='<h3>Fixtures</h3><div class="db-table"><table><thead><tr><th>Start</th><th>Materialized</th><th>Finalized</th></tr></thead><tbody>'+d.fixtures.map(f=>'<tr><td>'+esc(f.starts_at)+'</td><td>'+esc(f.materialized_at)+'</td><td>'+esc(f.finalized_at||'Open')+'</td></tr>').join('')+'</tbody></table></div><h3>Availability</h3><div class="db-table"><table><thead><tr><th>Fixture</th><th>Player</th><th>Status</th></tr></thead><tbody>'+d.availability.map(a=>'<tr><td>'+esc(a.startsAt)+'</td><td>'+esc(a.name)+'</td><td>'+(a.keen?'Keen':'Unavailable')+'</td></tr>').join('')+'</tbody></table></div><h3>Lineups</h3><div class="db-table"><table><thead><tr><th>Fixture</th><th>Player</th><th>Role</th><th>Position</th></tr></thead><tbody>'+d.lineups.map(l=>'<tr><td>'+esc(l.startsAt)+'</td><td>'+esc(l.name)+'</td><td>'+esc(l.role)+'</td><td>'+esc(l.position+1)+'</td></tr>').join('')+'</tbody></table></div>';}
document.querySelector('#finalize').onclick=async()=>{const r=await fetch('/api/admin/finalize',{method:'POST'});msg.textContent=r.ok?'Current selection finalized.':(await r.json()).error; if(r.ok)dashboard().then(load)};
async function load(){const fixtureId=document.querySelector('#fixture-select').value;const r=await fetch('/api/admin/lineup'+(fixtureId?'?fixtureId='+fixtureId:''));if(!r.ok){msg.textContent='No finalized fixture yet. Use “Finalize current selection” to create the test result.';return}const d=await r.json();document.querySelector('#fixture-select').value=d.fixture.id;const lineup=document.querySelector('#lineup');lineup.innerHTML=d.players.map(p=>`<div class="player lineup-row" draggable="true" data-id="${p.id}"><span class="drag-handle">☷</span><strong class="lineup-number"></strong><span class="lineup-name">${p.name}</span><label class="registered"><input type="checkbox" ${p.registered?'checked':''}> Registered</label><small class="lineup-role"></small></div>`).join('');const refreshOrder=()=>[...lineup.children].forEach((row,i)=>{row.querySelector('.lineup-number').textContent=i+1;row.querySelector('.lineup-role').textContent=row.querySelector('.registered input').checked?(i<10?'Player':`Reserve ${i-9}`):'Unregistered'});refreshOrder();let dragged;lineup.querySelectorAll('.lineup-row').forEach(row=>{row.ondragstart=()=>{dragged=row};row.ondragover=e=>{e.preventDefault();if(dragged&&dragged!==row){const rect=row.getBoundingClientRect();lineup.insertBefore(dragged,e.clientY<rect.top+rect.height/2?row:row.nextSibling);refreshOrder()}};row.querySelector('.registered input').onchange=refreshOrder});document.querySelector('#save').onclick=async()=>{const rows=[...lineup.children], registeredRows=rows.filter(row=>row.querySelector('.registered input').checked), selected=registeredRows.slice(0,10).map(row=>Number(row.dataset.id)), reserves=registeredRows.slice(10).map(row=>Number(row.dataset.id));const x=await fetch('/api/admin/lineup',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({fixtureId:d.fixture.id,selected,reserves})});msg.textContent=x.ok?'Saved.':(await x.json()).error; if(x.ok) load()};}
</script></Layout>
