---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../db/client.js';
import { history, statistics } from '../db/queries.js';
const historyData = await history(getDb(Astro.locals));
const statisticsData = await statistics(getDb(Astro.locals));
const totalFixtures = statisticsData.totalFixtures;
const scale = Math.max(1, ...statisticsData.players.map(p => p.selected + p.reserve));
---
<Layout title="Football registration">
  <main>
    <p class="eyebrow">WINTER FOOTBALL · 2026/27</p><h1>Who’s in?</h1>
    <p class="intro">Register your availability for the next fixture. Selection is randomized every Friday at noon.</p>
    <nav class="tabs"><a class="active" href="#registration">Registration</a><a href="#history">History</a><a href="#statistics">Statistics</a><a href="/admin">Admin</a></nav>
    <section id="registration" class="panel"><div class="section-heading"><div><p class="eyebrow">UPCOMING FIXTURE</p><h2 id="fixture-date">Loading…</h2></div><span id="window" class="pill">Checking window</span></div><p id="message" class="muted"></p><div id="roster" class="roster"></div></section>
    <section id="history" class="panel"><div class="section-heading"><div><p class="eyebrow">PAST WEEKS</p><h2>History</h2></div></div><div id="history-list">{historyData.length ? historyData.map(f => <article class="history-row"><strong>{new Intl.DateTimeFormat('en-GB',{dateStyle:'full',timeStyle:'short',timeZone:'Europe/Vienna'}).format(new Date(f.startsAt))}</strong><span><b>Selected:</b> {f.selected.join(', ') || '—'}</span><span>Reserves: {f.reserves.join(', ') || '—'}</span></article>) : 'No finalized fixtures yet.'}</div></section>
    <section id="statistics" class="panel"><div class="section-heading"><div><p class="eyebrow">SEASON TOTALS</p><h2>Statistics</h2></div></div><p class="muted stats-legend">Selected / reserves / finalized fixtures to date</p><div id="stats" class="stats">{statisticsData.players.map(p => <div class="bar-row"><span>{p.name}</span><div class="bar"><i class="selected" style={`width:${p.selected/scale*100}%`}></i><i class="reserve" style={`width:${p.reserve/scale*100}%`}></i></div><b>{p.selected} / {p.reserve} / {totalFixtures}</b></div>)}</div></section>
  </main>
  <script is:inline>
    // @ts-nocheck
    const roster = document.querySelector('#roster'), msg = document.querySelector('#message');
    const fmt = value => new Intl.DateTimeFormat('en-GB',{dateStyle:'full',timeStyle:'short',timeZone:'Europe/Vienna'}).format(new Date(value));
    async function load(){ try { const r=await fetch('/api/registration',{cache:'no-store'}); if(!r.ok) throw new Error('API returned '+r.status); const d=await r.json(); if(!d.fixture){document.querySelector('#fixture-date').textContent='No fixture available'; return;} document.querySelector('#fixture-date').textContent=fmt(d.fixture.startsAt); document.querySelector('#window').textContent=d.open?'Open until 12:00 Vienna time':'Registration closed'; roster.innerHTML=d.players.map(p=>`<label class="player"><span>${p.name}</span><input type="checkbox" data-id="${p.id}" ${p.keen?'checked':''} ${d.open?'':'disabled'}></label>`).join(''); roster.querySelectorAll('input').forEach(i=>i.onchange=async()=>{const x=await fetch('/api/availability',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({playerId:Number(i.dataset.id),keen:i.checked})});if(!x.ok){i.checked=!i.checked;msg.textContent=(await x.json()).error||'Could not update.';}else msg.textContent='Saved.';}); } catch (error) { document.querySelector('#fixture-date').textContent='Could not load fixture'; msg.textContent=error.message; } }
    async function secondary(){ const s=await (await fetch('/api/statistics',{cache:'no-store'})).then(r=>r.json()), scale=Math.max(1,...s.players.map(p=>p.selected+p.reserve)); document.querySelector('#stats').innerHTML=s.players.map(p=>`<div class="bar-row"><span>${p.name}</span><div class="bar"><i class="selected" style="width:${p.selected/scale*100}%"></i><i class="reserve" style="width:${p.reserve/scale*100}%"></i></div><b>${p.selected} / ${p.reserve} / ${s.totalFixtures}</b></div>`).join(''); const h=await (await fetch('/api/history',{cache:'no-store'})).json(); document.querySelector('#history-list').innerHTML=h.fixtures.length?h.fixtures.map(f=>`<article class="history-row"><strong>${fmt(f.startsAt)}</strong><span>Selected: ${f.selected.join(', ')||'—'}</span><span><b>Reserves:</b> ${f.reserves.join(', ')||'—'}</span></article>`).join(''):'No finalized fixtures yet.'; }
    load(); secondary(); setInterval(secondary, 5000);
  </script>
</Layout>
