---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Football registration">
  <main>
    <p class="eyebrow">WINTER FOOTBALL · 2026/27</p><h1>Who’s in?</h1>
    <p class="intro">Register your availability for the next fixture. Selection is randomized every Friday at noon.</p>
    <img class="splash" src="/images/football-splash-indoor-turf.webp" alt="A football on an indoor artificial-turf pitch under warm floodlights" width="1750" height="899" fetchpriority="high" />
    <nav class="tabs"><a class="active" href="#registration">Registration</a><a href="#history">History</a><a href="#statistics">Statistics</a><a href="/admin">Admin</a></nav>
    <section id="registration" class="panel"><div class="section-heading"><div><p class="eyebrow">UPCOMING FIXTURE</p><h2 id="fixture-date">Loading…</h2></div><span id="window" class="pill">Checking window</span></div><p id="message" class="muted"></p><div id="roster" class="roster"></div></section>
    <section id="history" class="panel"><div class="section-heading"><div><p class="eyebrow">PAST WEEKS</p><h2>History</h2></div></div><div id="history-list">Loading…</div></section>
    <section id="statistics" class="panel"><div class="section-heading"><div><p class="eyebrow">SEASON TOTALS</p><h2>Statistics</h2></div><button id="stats-toggle" type="button">Chronological view</button></div><p id="stats-legend" class="muted stats-legend">Selected / reserves / finalized fixtures to date</p><div id="stats" class="stats">Loading…</div></section>
  </main>
  <script is:inline>
    // @ts-nocheck
    const roster = document.querySelector('#roster'), msg = document.querySelector('#message');
    const fmt = value => new Intl.DateTimeFormat('en-GB',{dateStyle:'full',timeStyle:'short',timeZone:'Europe/Vienna'}).format(new Date(value));
    async function load(){ try { const r=await fetch('/api/registration',{cache:'no-store'}); if(!r.ok) throw new Error('API returned '+r.status); const d=await r.json(); if(!d.fixture){document.querySelector('#fixture-date').textContent='No fixture available'; document.querySelector('#window').textContent='No upcoming fixture'; return;} document.querySelector('#fixture-date').textContent=fmt(d.fixture.startsAt); document.querySelector('#window').textContent=d.open?'Open until '+fmt(d.fixture.registrationClosesAt):'Opens '+fmt(d.fixture.registrationOpensAt); roster.innerHTML=d.players.map(p=>`<label class="player"><span>${p.name}</span><input type="checkbox" data-id="${p.id}" ${p.keen?'checked':''} ${d.open?'':'disabled'}></label>`).join(''); roster.querySelectorAll('input').forEach(i=>i.onchange=async()=>{const x=await fetch('/api/availability',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({playerId:Number(i.dataset.id),keen:i.checked})});if(!x.ok){i.checked=!i.checked;msg.textContent=(await x.json()).error||'Could not update.';}else msg.textContent='Saved.';}); } catch (error) { document.querySelector('#fixture-date').textContent='Could not load fixture'; msg.textContent=error.message; } }
    let chronological=false, latestStats;
    const renderStats=s=>{const target=document.querySelector('#stats'),legend=document.querySelector('#stats-legend'),toggle=document.querySelector('#stats-toggle');if(!s)return;if(chronological){legend.textContent='Fixtures oldest to newest · green selected · yellow reserve · grey not selected';toggle.textContent='Totals view';target.className='stats';target.innerHTML=s.players.map(p=>'<div class="bar-row chronological-row"><span>'+p.name+'</span><div class="bar chronological-bar">'+p.appearances.map((role,i)=>'<i class="'+(role||'empty')+'" title="'+fmt(s.fixtures[i].startsAt)+' · '+(role||'Not selected')+'"></i>').join('')+'</div><b>'+p.selected+' / '+p.reserve+' / '+s.totalFixtures+'</b></div>').join('')}else{legend.textContent='Selected / reserves / finalized fixtures to date';toggle.textContent='Chronological view';target.className='stats';const scale=Math.max(1,...s.players.map(p=>p.selected+p.reserve));target.innerHTML=s.players.map(p=>`<div class="bar-row"><span>${p.name}</span><div class="bar"><i class="selected" style="width:${p.selected/scale*100}%"></i><i class="reserve" style="width:${p.reserve/scale*100}%"></i></div><b>${p.selected} / ${p.reserve} / ${s.totalFixtures}</b></div>`).join('')}};
    document.querySelector('#stats-toggle').onclick=()=>{chronological=!chronological;renderStats(latestStats)};
    async function secondary(){try{const r=await fetch('/api/public-summary',{cache:'no-store'});if(!r.ok)throw new Error('API returned '+r.status);const d=await r.json(),s=d.statistics;latestStats=s;renderStats(s);const h=d.history;document.querySelector('#history-list').innerHTML=h.length?h.map(f=>`<article class="history-row"><strong>${fmt(f.startsAt)}</strong><span><b>Selected:</b> ${f.selected.join(', ')||'—'}</span><span><b>Reserves:</b> ${f.reserves.join(', ')||'—'}</span></article>`).join(''):'No finalized fixtures yet.';}catch(error){console.error('Could not refresh history/statistics',error);}}
    let refreshTimer;
    const scheduleSecondary=()=>{clearTimeout(refreshTimer);if(!document.hidden)refreshTimer=setTimeout(async()=>{await secondary();scheduleSecondary()},30000)};
    document.addEventListener('visibilitychange',()=>{if(document.hidden)clearTimeout(refreshTimer);else{secondary().finally(scheduleSecondary)}});
    load(); secondary().finally(scheduleSecondary);
  </script>
</Layout>
