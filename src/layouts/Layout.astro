---
const { title } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');
:root{font-family:Manrope,sans-serif;color:#18231d;background:#e9eee8}*{box-sizing:border-box}body{margin:0}main{max-width:920px;margin:auto;padding:60px 22px}h1{font-size:clamp(3rem,9vw,7rem);line-height:.9;margin:10px 0 20px;letter-spacing:-.08em}h2{margin:0;font-size:2rem;letter-spacing:-.04em}.intro{max-width:480px;color:#536057;font-size:1.1rem}.eyebrow{font:500 .72rem 'DM Mono',monospace;letter-spacing:.12em;color:#668071}.tabs{display:flex;gap:8px;margin:42px 0 16px;flex-wrap:wrap}.tabs a{padding:10px 15px;border:1px solid #c9d2c8;border-radius:99px;color:inherit;text-decoration:none}.tabs a.active,.tabs a:hover{background:#203d2a;color:white}.panel{background:#f8faf7;border:1px solid #d5ddd4;border-radius:18px;padding:24px;margin:16px 0}.section-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.pill{background:#d8eedb;border-radius:99px;padding:8px 12px;font-size:.8rem}.muted{color:#718078}.roster{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px;margin-top:20px}.player{display:flex;justify-content:space-between;padding:13px 14px;border:1px solid #dce3da;border-radius:10px;background:white}.player input{accent-color:#26723d}.history-row{padding:16px 0;border-bottom:1px solid #dce3da;display:grid;gap:5px}.stats{display:grid;gap:10px}.bar-row{display:grid;grid-template-columns:190px 1fr 50px;gap:10px;align-items:center;font-size:.85rem}.bar{display:flex;height:10px;background:#e0e8df;border-radius:5px;overflow:hidden}.bar i{display:block;height:100%}.bar i.selected{background:#37834d}.bar i.reserve{background:#e2b94b}.bar-row b{font:12px 'DM Mono',monospace}
:root{font-family:Manrope,sans-serif;color:#18231d;background:#e9eee8}*{box-sizing:border-box}body{margin:0}main{max-width:920px;margin:auto;padding:60px 22px}h1{font-size:clamp(3rem,9vw,7rem);line-height:.9;margin:10px 0 20px;letter-spacing:-.08em}h2{margin:0;font-size:2rem;letter-spacing:-.04em}h3{margin:24px 0 10px;font-size:1rem}.intro{max-width:480px;color:#536057;font-size:1.1rem}.eyebrow{font:500 .72rem 'DM Mono',monospace;letter-spacing:.12em;color:#668071}.tabs{display:flex;gap:8px;margin:42px 0 16px;flex-wrap:wrap}.tabs a{padding:10px 15px;border:1px solid #c9d2c8;border-radius:99px;color:inherit;text-decoration:none}.tabs a.active,.tabs a:hover{background:#203d2a;color:white}.panel{background:#f8faf7;border:1px solid #d5ddd4;border-radius:18px;padding:24px;margin:16px 0}.section-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.pill{background:#d8eedb;border-radius:99px;padding:8px 12px;font-size:.8rem}.muted{color:#718078}.roster{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px;margin-top:20px}.player{display:flex;justify-content:space-between;padding:13px 14px;border:1px solid #dce3da;border-radius:10px;background:white}.player input{accent-color:#26723d}.history-row{padding:16px 0;border-bottom:1px solid #dce3da;display:grid;gap:5px}.stats{display:grid;gap:10px}.bar-row{display:grid;grid-template-columns:190px 1fr 50px;gap:10px;align-items:center;font-size:.85rem}.bar{display:flex;height:10px;background:#e0e8df;border-radius:5px;overflow:hidden}.bar i{display:block;height:100%}.bar i.selected{background:#37834d}.bar i.reserve{background:#e2b94e}.bar-row b{font:12px 'DM Mono',monospace}.back-form{display:inline-block;margin-bottom:18px}.back-form button{cursor:pointer;padding:10px 14px;border:1px solid #c9d2c8;border-radius:99px;background:#f8faf7;color:#18231d;font:600 .9rem Manrope,sans-serif}.db-table{overflow:auto;border:1px solid #dce3da;border-radius:10px;background:white}.db-table table{width:100%;border-collapse:collapse;font-size:.8rem;text-align:left}.db-table th,.db-table td{padding:9px 10px;border-bottom:1px solid #edf1eb;white-space:nowrap}.db-table th{font:500 .68rem 'DM Mono',monospace;color:#668071;text-transform:uppercase}
.bar-row{grid-template-columns:190px minmax(0,1fr) 120px}.bar-row b{white-space:nowrap}.reserve-order{width:54px;padding:6px;border:1px solid #c9d2c8;border-radius:6px}
.lineup-row{align-items:center;justify-content:flex-start;gap:10px;cursor:grab}.lineup-row:active{cursor:grabbing}.drag-handle{color:#668071;font-size:1.2rem}.lineup-number{width:24px}.lineup-role{margin-left:auto;color:#668071;font-family:'DM Mono',monospace;font-size:.72rem}.section-heading button{cursor:pointer;padding:9px 12px;border:1px solid #c9d2c8;border-radius:99px;background:#f8faf7;color:#18231d;font:600 .78rem Manrope,sans-serif}.timeline{overflow-x:auto}.timeline-head,.timeline-row{display:grid;grid-template-columns:190px max-content;gap:10px;align-items:center;min-width:max-content}.timeline-head{margin-bottom:6px;color:#668071}.timeline-head>div,.timeline-row>div{display:grid;grid-auto-flow:column;grid-auto-columns:32px;gap:3px}.timeline-head b{font:500 .62rem 'DM Mono',monospace;text-align:center}.timeline-row{padding:4px 0;font-size:.85rem}.timeline-row i{display:block;width:32px;height:18px;border-radius:4px;background:#e6ece5}.timeline-row i.selected{background:#37834d}.timeline-row i.reserve{background:#e2b94b}
</style></head><body><slot/></body></html>
